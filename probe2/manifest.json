{
  "manifest_version": 3,
  "name": "Handle Transfer Probe",
  "version": "0.0.1",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "receiver.html",
        "receiver.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}